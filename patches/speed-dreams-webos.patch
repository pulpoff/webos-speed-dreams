diff --git a/src/modules/graphic/ssggraph/grscreen.cpp b/src/modules/graphic/ssggraph/grscreen.cpp
index a3bd336..7aa89d1 100644
--- a/src/modules/graphic/ssggraph/grscreen.cpp
+++ b/src/modules/graphic/ssggraph/grscreen.cpp
@@ -390,6 +390,118 @@ void cGrScreen::camDraw(tSituation *s)
 
 
 /* Update screen display */
+#ifdef WEBOS
+// The TV's Mali-G51 cannot fill 1080p with this scene at a playable rate: the 3D view is drawn at a
+// lower height (graph.xml's "render height" in the Graphic section, 720 by default; 0 for the full
+// screen) into a texture, which then fills the screen. The mirror, boards and menus are drawn
+// afterwards, at the full resolution.
+static GLuint grRenderFbo = 0, grRenderTex = 0, grRenderDepth = 0;
+static int grRenderW = 0, grRenderH = 0;
+static bool grRenderFailed = false;
+
+static bool grRenderTargetBegin(int scrw, int scrh)
+{
+    const int h = (int)GfParmGetNum(grHandle, GR_SCT_GRAPHIC, "render height", NULL, 720);
+    if (grRenderFailed || h <= 0 || h >= scrh)
+        return false;
+    const int w = (scrw * h / scrh + 1) & ~1;
+    if (w != grRenderW || h != grRenderH)
+    {
+        if (!grRenderFbo)
+        {
+            glGenFramebuffers(1, &grRenderFbo);
+            glGenTextures(1, &grRenderTex);
+            glGenRenderbuffers(1, &grRenderDepth);
+        }
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, grRenderTex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, w, h, 0, GL_RGB, GL_UNSIGNED_BYTE, NULL);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindTexture(GL_TEXTURE_2D, 0);
+        glBindRenderbuffer(GL_RENDERBUFFER, grRenderDepth);
+        glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, w, h);
+        glBindRenderbuffer(GL_RENDERBUFFER, 0);
+        glBindFramebuffer(GL_FRAMEBUFFER, grRenderFbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, grRenderTex, 0);
+        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, grRenderDepth);
+        const GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        if (status != GL_FRAMEBUFFER_COMPLETE)
+        {
+            GfLogError("webOS: no %dx%d render target (status 0x%x); drawing at full size\n", w, h, status);
+            grRenderFailed = true;
+            return false;
+        }
+        GfLogInfo("webOS: the 3D view is drawn at %dx%d\n", w, h);
+        grRenderW = w;
+        grRenderH = h;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, grRenderFbo);
+    glViewport(0, 0, grRenderW, grRenderH);
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+    return true;
+}
+
+// Stretches the drawn view over the screen. PLIB's cached GL state is reset by its next
+// ssgCullAndDraw, and the boards set what they use.
+static void grRenderTargetEnd(int scrx, int scry, int scrw, int scrh)
+{
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glViewport(scrx, scry, scrw, scrh);
+
+    glMatrixMode(GL_TEXTURE);
+    glPushMatrix();
+    glLoadIdentity();
+    glMatrixMode(GL_PROJECTION);
+    glPushMatrix();
+    glLoadIdentity();
+    glOrtho(0, 1, 0, 1, -1, 1);
+    glMatrixMode(GL_MODELVIEW);
+    glPushMatrix();
+    glLoadIdentity();
+
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_LIGHTING);
+    glDisable(GL_FOG);
+    glDisable(GL_BLEND);
+    glDisable(GL_ALPHA_TEST);
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_COLOR_MATERIAL);
+    for (int unit = grMaxTextureUnits - 1; unit > 0; unit--)
+    {
+        glActiveTexture(GL_TEXTURE0 + unit);
+        glDisable(GL_TEXTURE_2D);
+    }
+    glActiveTexture(GL_TEXTURE0);
+    glDisable(GL_TEXTURE_GEN_S);
+    glDisable(GL_TEXTURE_GEN_T);
+    glEnable(GL_TEXTURE_2D);
+    glBindTexture(GL_TEXTURE_2D, grRenderTex);
+    glTexEnvf(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE);
+    glColor4f(1.0f, 1.0f, 1.0f, 1.0f);
+    glBegin(GL_TRIANGLE_STRIP);
+    glTexCoord2f(0, 0); glVertex2f(0, 0);
+    glTexCoord2f(1, 0); glVertex2f(1, 0);
+    glTexCoord2f(0, 1); glVertex2f(0, 1);
+    glTexCoord2f(1, 1); glVertex2f(1, 1);
+    glEnd();
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glTexEnvf(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE);
+
+    glMatrixMode(GL_MODELVIEW);
+    glPopMatrix();
+    glMatrixMode(GL_PROJECTION);
+    glPopMatrix();
+    glMatrixMode(GL_TEXTURE);
+    glPopMatrix();
+    glMatrixMode(GL_MODELVIEW);
+    glEnable(GL_DEPTH_TEST);
+}
+#endif
+
