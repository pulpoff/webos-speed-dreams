diff --git a/src/main/main.cpp b/src/main/main.cpp
index 6a2dfbd..6415bc8 100644
--- a/src/main/main.cpp
+++ b/src/main/main.cpp
@@ -41,6 +41,108 @@
 #include <iraceengine.h>
 #include <iuserinterface.h>
 
+#ifdef WEBOS
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <climits>
+#include <vector>
+#include <glob.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+/*
+ * webOS starts the binary that appinfo.json names as "main" directly, from anywhere, with the app
+ * manager's JSON launch parameters as its one argument; and the luna bus only knows the app by that
+ * executable, so a wrapper script would leave it stuck behind the launch spinner. So the wrapper's
+ * work happens here, before the application parses its options:
+ * - the log goes to /tmp/speed-dreams.log;
+ * - the remote's Back button reaches the game (as Escape) instead of closing the app;
+ * - the libraries, modules and robots are in the app folder, and the data in its data/;
+ * - the user settings, results and replays go to speed-dreams/home on a USB drive when one has a
+ *   speed-dreams folder, so they survive reinstalling the app, or else the app folder's home/;
+ *   a full data set in that folder's data/ (from speed-dreams-data and its car and track
+ *   repositories) replaces the app's own;
+ * - {"startrace": "<race>"} in the launch parameters runs that race (config/raceman/<race>.xml);
+ * - /tmp/speed-dreams.env, if there, sets environment variables for testing, one NAME=value per
+ *   line: gl4es' LIBGL_* options, SD_WEBOS_BENCH (a race starts without waiting for Ready).
+ */
+static std::vector<std::string> WebOSArgs;
+static std::vector<char*> WebOSArgv;
+
+static void webOSStart(int& argc, char**& argv)
+{
+	if (freopen("/tmp/speed-dreams.log", "w", stdout))
+		dup2(fileno(stdout), fileno(stderr));
+	setvbuf(stdout, NULL, _IOLBF, 0);
+
+	setenv("SDL_WEBOS_ACCESS_POLICY_KEYS_BACK", "true", 1);
+
+	if (FILE *env = fopen("/tmp/speed-dreams.env", "r"))
+	{
+		char line[256];
+		while (fgets(line, sizeof(line), env))
+		{
+			line[strcspn(line, "\r\n")] = '\0';
+			char *eq = strchr(line, '=');
+			if (line[0] != '#' && eq && eq != line)
+			{
+				*eq = '\0';
+				setenv(line, eq + 1, 1);
+				printf("webOS: %s=%s\n", line, eq + 1);
+			}
+		}
+		fclose(env);
+	}
+
+	char exe[PATH_MAX];
+	ssize_t n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+	std::string app = ".";
+	if (n > 0)
+	{
+		exe[n] = '\0';
+		app = exe;
+		app.erase(app.rfind('/'));
+	}
+
+	std::string data = app + "/data/", home = app + "/home/";
+	glob_t g;
+	if (glob("/tmp/usb/*/*/speed-dreams", GLOB_ONLYDIR, NULL, &g) == 0 && g.gl_pathc > 0)
+	{
+		const std::string usb = g.gl_pathv[0];
+		home = usb + "/home/";
+		struct stat st;
+		if (stat((usb + "/data/config/raceengine.xml").c_str(), &st) == 0)
+			data = usb + "/data/";
+	}
+	globfree(&g);
+	mkdir(home.c_str(), 0775);
+	printf("webOS: app %s, data %s, home %s\n", app.c_str(), data.c_str(), home.c_str());
+
+	WebOSArgs = { argv[0], "--localdir", home, "--datadir", data,
+		"--libdir", app + "/", "--bindir", app + "/" };
+	// the app manager's JSON parameters are not options, but may name a race to run; anything
+	// else is kept
+	for (int i = 1; i < argc; i++)
+		if (argv[i][0] != '{')
+			WebOSArgs.push_back(argv[i]);
+		else if (const char *k = strstr(argv[i], "\"startrace\""))
+		{
+			const char *b = strchr(k + 11, '"'), *e = b ? strchr(b + 1, '"') : NULL;
+			if (e)
+			{
+				WebOSArgs.push_back("--startrace");
+				WebOSArgs.push_back(std::string(b + 1, e));
+			}
+		}
+	for (auto& s : WebOSArgs)
+		WebOSArgv.push_back(&s[0]);
+	WebOSArgv.push_back(NULL);
+	argc = (int)WebOSArgs.size();
+	argv = WebOSArgv.data();
+}
+#endif
+
 // If defined in tgf.h:
 // Use new Memory Manager ...
 #ifdef __DEBUG_MEMORYMANAGER__
@@ -126,6 +228,10 @@ main(int argc, char *argv[])
 #endif
 // ... Use new Memeory Manager
 
