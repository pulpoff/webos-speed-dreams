+#endif
         {
             GfLogError("curl_multi_poll: %s\n", curl_multi_strerror(code));
             return;
         }
+#ifdef WEBOS
+        if (!numfds && msd >= 1)
+            GfSleep(msd / 1000.0);
+#endif
 
         double elapsed = (GfTimeClock() - now) * 1000.0;
 
