         double now = GfTimeClock();
         CURLMcode code = curl_multi_perform(multi, &running);
+#ifdef WEBOS
+        // webOS 6 has libcurl 7.61, and curl_multi_poll came in 7.66 (nothing here wakes it up).
+        // curl_multi_wait returns at once when it has nothing to wait on, where curl_multi_poll
+        // would sleep the timeout out, so that sleep is done here.
+        int numfds = 0;
+#endif
 
         if (code != CURLM_OK)
         {
             GfLogError("curl_multi_perform: %s\n", curl_multi_strerror(code));
